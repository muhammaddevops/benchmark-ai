# Copy to .env and fill in what you have. `python -m bench doctor` shows what each stack still needs.
# Never commit .env.

# --- required: the call itself ------------------------------------------------------------------
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# the simulated caller's voice + re-transcription of what the agent said (ElevenLabs).
# Without quota: cached caller lines replay, new lines use a local macOS voice, re-transcription uses local Whisper.
ELEVEN_LABS=

# --- judge (optional; default is a free local model via Ollama: qwen3:14b) ---------------------
# BENCH_JUDGE=openai:gpt-5.5          # or gemini:gemini-3-flash, ollama:qwen3:14b, compat:<model>
# BENCH_TESTER_LLM=ollama:qwen3:14b   # writes the caller's lines in --mode dynamic
# BENCH_TRANSCRIBER=auto              # auto (Scribe, then local Whisper) | eleven | whisper

# --- phone calls to hosted agents (scripts/setup_sip.py creates BENCH_SIP_TRUNK_ID) -------------
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=
BENCH_SIP_TRUNK_ID=

# --- Gulf / regional providers (providers.yaml has each one's test path) --------------------------
MUNSIT_API_KEY=                 # Munsit STT + Faseeh TTS (CNTXT AI, UAE)
NABRAH_API_KEY=                 # Nabrah STT (Saudi), keys start nb_
SARJ_STT_API_KEY=               # Sarj STT (Saudi)
SARJ_TTS_API_KEY=               # Sarj TTS (Saudi)
FANAR_API_KEY=                  # Fanar LLM/STT/TTS (QCRI, Qatar); request access at api.fanar.qa/request
CAMB_API_KEY=                   # CAMB.AI MARS TTS (Dubai)
HUMAIN_VOICE_API_KEY=           # HUMAIN Voice (Saudi), bench/adapters/humain.py
HUMAIN_VOICE_API_URL=           # from HUMAIN onboarding, e.g. https://api.voice.humain.com

# --- global providers (LiveKit plugins) -----------------------------------------------------------
OPENAI_API_KEY=                 # also the reference pipeline's LLM (GPT-5.4 mini)
GOOGLE_API_KEY=                 # Gemini API (Gemini Live, Gemini LLM)
GOOGLE_APPLICATION_CREDENTIALS= # Google Cloud STT/TTS (service account JSON path)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=            # e.g. uaenorth, qatarcentral
DEEPGRAM_API_KEY=
SPEECHMATICS_API_KEY=
SONIOX_API_KEY=
GLADIA_API_KEY=
ASSEMBLYAI_API_KEY=
CARTESIA_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
TELNYX_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=me-central-1

# --- hosted voice agents: their phone numbers (E.164, e.g. +9665XXXXXXXX) --------------------------
# set each agent up with `bench brief <scenario>` first; one stack per agent: stacks/agent-<name>.yaml
MAQSAM_AGENT_NUMBER=
NABRAH_AGENT_NUMBER=
HAMSA_AGENT_NUMBER=
UNIFONIC_AGENT_NUMBER=
HAMS_AGENT_NUMBER=
DAYL_AGENT_NUMBER=
ZIWO_AGENT_NUMBER=
WITTIFY_AGENT_NUMBER=
SAWT_AGENT_NUMBER=
ARABICAI_AGENT_NUMBER=
VAPI_AGENT_NUMBER=
RETELL_AGENT_NUMBER=
ELEVENLABS_AGENT_NUMBER=
SYNTHFLOW_AGENT_NUMBER=
BLAND_AGENT_NUMBER=
